# =====================================================================
# MOJ KNJIŽNI KOTIČEK – Konfiguracijska predloga (.env.example)
# =====================================================================
# Pred zagonom kopiraj to datoteko v .env in nastavi ustrezne vrednosti.
# Datoteke .env NIKOLI ne objavljaj na GitHubu ali drugih javnih mestih!

# Okolje: development (lokalni razvoj z uvicorn) ali production (NeoServ/LiteSpeed/cPanel)
APP_ENV=development

# Skrivni ključ za podpisovanje sej (piškotkov).
# V produkciji OBVEZNO generiraj naključen niz z najmanj 40 znaki:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=zamenjaj-z-nakljucnim-skrivnim-kljucem-vsaj-40-znakov

# Zahtevaj HTTPS za piškotke (1 za produkcijo s certifikatom SSL/HTTPS, 0 za lokalni razvoj)
SESSION_HTTPS_ONLY=0

# Povezava s podatkovno bazo:
# 1) MariaDB / MySQL (priporočeno za produkcijo na NeoServ / cPanel):
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ime_baze
DB_USER=uporabnik_baze
DB_PASSWORD=geslo_baze

# 2) Ali neposreden URL povezave (neobvezno; če ni nastavljen, se sestavi iz zgornjih DB_*):
# DATABASE_URL=mysql+pymysql://uporabnik_baze:geslo_baze@localhost:3306/ime_baze?charset=utf8mb4

# 3) Za lokalni razvoj brez MariaDB:
# Če pustiš DB_NAME in DB_USER prazna ter DATABASE_URL nenastavljen,
# aplikacija samodejno uporabi lokalno SQLite bazo (local_library.db).

# =====================================================================
# SISTEMSKE NASTAVITVE (E-pošta, Registracija, Roki izposoj)
# =====================================================================
# Nastavitve SMTP za pošiljanje obvestil in ponastavitev gesel prek e-pošte.
# Če SMTP ni konfiguriran, se e-poštna sporočila samodejno varno beležijo v tmp/mail.log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=knjiznica@primer.si
SMTP_TLS=1

# Dovoljena javna registracija novih uporabnikov (1 = omogočeno, 0 = onemogočeno):
REGISTRATION_ENABLED=1

# Privzeti rok izposoje knjig v dneh:
DEFAULT_LOAN_DAYS=30

# =====================================================================
# ENKRATNA NASTAVITEV ZA USTVARJANJE PRVEGA ADMINISTRATORJA (scripts/create_admin.py)
# Po uspešnem zagonu skripte create_admin.py se te vrstice samodejno počistijo iz .env.
# =====================================================================
# BOOTSTRAP_LOCATION_NAME=Glavna knjižnica
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=VarnoGeslo1234#
